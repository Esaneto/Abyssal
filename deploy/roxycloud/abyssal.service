[Unit]
Description=Abyssal authoritative multiplayer server - RoxyCloud Ryzen 4GB
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=abyssal
Group=abyssal
WorkingDirectory=/opt/abyssal
EnvironmentFile=/etc/abyssal/abyssal.env
Environment=NODE_ENV=production
Environment=ABYSSAL_RESOURCE_PROFILE=roxycloud-ryzen4
Environment=ABYSSAL_ASYNC_PERSISTENCE=true
Environment=UV_THREADPOOL_SIZE=4
Environment=HTTP_BACKLOG=4096
Environment=DATABASE_POOL_MAX=5
Environment=NODE_OPTIONS=--max-old-space-size=1536
ExecStart=/usr/local/bin/node /opt/abyssal/server.js
Restart=always
RestartSec=2
TimeoutStopSec=15
KillSignal=SIGTERM
LimitNOFILE=65535
TasksMax=512
MemoryHigh=3072M
MemoryMax=3584M
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/abyssal/data

[Install]
WantedBy=multi-user.target
