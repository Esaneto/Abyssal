# Copie os valores para o painel do provedor. Nunca faça commit de credenciais reais.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST/BANCO?sslmode=require
# Password recovery is disabled until a verified sender and the public HTTPS URL are configured.
# SENDGRID_API_KEY=SG.substitua_no_painel_do_provedor
# RECOVERY_FROM_EMAIL=conta-remetente-verificada@seudominio.com
# PUBLIC_BASE_URL=https://seu-dominio-publico.example
# Optional comma-separated origins allowed to connect from another frontend domain.
# APP_ALLOWED_ORIGINS=https://www.seudominio.com
# Opcional: defina como disable apenas se o seu banco não exigir TLS.
# DATABASE_SSL=disable
# Stripe permanece desativado sem as credenciais configuradas. Use somente chaves sk_test_ para testes.
# STRIPE_SECRET_KEY=sk_test_substitua_no_painel_do_provedor
# STRIPE_WEBHOOK_SECRET=whsec_substitua_no_painel_do_provedor
# Live requer autorização explícita e revisão legal concluída; mantenha ambos desativados.
# STRIPE_LIVE_ENABLED=false
# STRIPE_LIVE_LEGAL_APPROVED=false
# Os requisitos abaixo são gates operacionais adicionais, não um certificado de conformidade.
# Vendas live também exigem que os valores estejam preenchidos e as revisões estejam concluídas.
# LEGAL_SELLER_NAME=
# LEGAL_SELLER_ADDRESS=
# LEGAL_SUPPORT_EMAIL=
# LEGAL_PRIVACY_EMAIL=
# LEGAL_REFUND_POLICY_URL=
# LEGAL_MARKETS=BR
# LEGAL_REVIEWED=false
# CONSUMER_FLOW_REVIEWED=false
# AGE_ASSURANCE_PROVIDER=
# AGE_ASSURANCE_READY=false
# ABYSSAL_PARENTAL_CONTROLS_READY=false
# ABYSSAL_CHAT_MODERATION_READY=false
# ABYSSAL_REWARD_POLICY_REVIEWED=false
# Recursos sociais e recompensas aleatórias também permanecem desligados por padrão.
# ABYSSAL_CHAT_ENABLED=false
# ABYSSAL_REWARDED_WHEEL_ENABLED=false
# Preview only: warn visitors that accounts and progress are temporary.
# ABYSSAL_PREVIEW_MODE=true
STRIPE_IDENTITY_TEST_ENABLED=false
STRIPE_IDENTITY_WEBHOOK_SECRET=
